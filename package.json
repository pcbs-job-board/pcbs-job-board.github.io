{
  "name": "pcbs-job-board",
  "version": "0.14.2",
  "private": true,
  "description": "Job manager for PC Building Simulator – a static web app (no build step). These scripts are for development only.",
  "license": "MIT",
  "scripts": {
    "lint": "eslint js eslint.config.mjs",
    "format": "prettier --write \"js/**/*.js\" \"css/**/*.css\" eslint.config.mjs",
    "format:check": "prettier --check \"js/**/*.js\" \"css/**/*.css\" eslint.config.mjs",
    "db": "python3 tools/build_db.py",
    "serve": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "eslint": "10.1.0",
    "espree": "11.2.0",
    "prettier": "3.8.1"
  }
}
